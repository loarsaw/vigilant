{
  "name": "vigilant-jobs-react",
  "version": "0.1.0",
  "description": "React hooks for fetching job postings and applying to them, built on vigilant-jobs-client.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["jobs", "careers", "react", "hooks", "api-client"],
  "license": "MIT",
  "dependencies": {
    "vigilant-jobs-client": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.5.4"
  }
}
